# Resume open counter (production only). Names only; set real values in Vercel, never commit them.
# Injected by the Vercel Marketplace "Upstash for Redis" integration:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names, also accepted:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Random secret used to hash visitors (openssl rand -hex 32):
RESUME_COUNTER_SALT=

# Site visitor total (Vercel Web Analytics API). Set in Vercel for Production only.
# Token: Vercel dashboard -> Account settings -> Tokens, scoped to the team that owns this project.
VERCEL_ANALYTICS_TOKEN=
# Project settings -> General -> Project ID (prj_...):
VERCEL_ANALYTICS_PROJECT_ID=
# Only for projects owned by a team (team_...); leave empty for a personal account:
VERCEL_ANALYTICS_TEAM_ID=
